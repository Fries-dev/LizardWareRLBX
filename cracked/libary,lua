local function Opt(Data, Key, Default)
    if type(Data) ~= "table" then return Default end
    local Value = Data[Key] or Data[string.lower(Key)]
    if Value == nil then return Default end
    return Value
end

local function Create(Class, Props)
    local Item = Instance.new(Class)
    if Item:IsA("GuiObject") then
        Item.BorderSizePixel = 0
        if Item:IsA("GuiButton") then Item.AutoButtonColor = false end
    end
    if Item:IsA("TextLabel") or Item:IsA("TextButton") or Item:IsA("TextBox") then
        Item.FontFace = Library.Font
        Item.TextSize = 12
        Item.TextColor3 = Library.Theme.Text
        Item.BackgroundTransparency = 1
        if Item:IsA("TextButton") then Item.Text = "" end
    end
    if Item:IsA("ImageLabel") or Item:IsA("ImageButton") then
        Item.BackgroundTransparency = 1
    end
    local Parent = Props.Parent
    for Property, Value in pairs(Props) do
        if Property ~= "Parent" then Item[Property] = Value end
    end
    Item.Parent = Parent
    return Item
end

local function GradientStroke(Parent, Thickness)
    local Stroke = Create("UIStroke", {
        Parent = Parent,
        Color = Color3.new(1, 1, 1),
        Thickness = Thickness,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        LineJoinMode = Enum.LineJoinMode.Miter
    })
    local Gradient = Create("UIGradient", {
        Parent = Stroke,
        Rotation = 37.84,
        Color = Library.Gradient
    })
    Library.GradientItems[Gradient] = true
    return Stroke
end

local function MakeDraggable(Handle, Target)
    local Dragging = false
    local DragStart, StartPosition
    Handle.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            DragStart = Input.Position
            StartPosition = Target.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(Input)
        if Dragging and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
            local Delta = Input.Position - DragStart
            Target.Position = UDim2New(StartPosition.X.Scale, StartPosition.X.Offset + Delta.X, StartPosition.Y.Scale, StartPosition.Y.Offset + Delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = false
        end
    end)
end

function Library:AddToTheme(Item, Properties)
    local Map = self.ThemeMap[Item] or {}
    self.ThemeMap[Item] = Map
    for Property, Key in pairs(Properties) do
        Map[Property] = Key
        Item[Property] = self.Theme[Key]
    end
end

function Library:Unload()
    if self.Holder then self.Holder:Destroy() end
    Env.Library = nil
end

