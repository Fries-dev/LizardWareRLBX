function Library:Window(Data)
    Data = Data or {}
    local WindowSize = Opt(Data, "Size", UDim2New(0, 686, 0, 678))

    local WindowClass = {}
    WindowClass.Pages = {}

    local MainFrame = Create("Frame", {
        Name = "Window",
        Parent = self.Holder,
        AnchorPoint = Vector2New(0.5, 0.5),
        Position = UDim2New(0.5, 0, 0.5, 0),
        Size = WindowSize,
        BackgroundColor3 = self.Theme.Background,
        Active = true
    })
    self:AddToTheme(MainFrame, { BackgroundColor3 = "Background" })
    GradientStroke(MainFrame, 2)
    MakeDraggable(MainFrame, MainFrame)

    local Header = Create("Frame", {
        Name = "Header",
        Parent = MainFrame,
        Position = UDim2New(0, 12, 0, 12),
        Size = UDim2New(1, -24, 0, 48),
        BackgroundTransparency = 1
    })

    local LogoBox = Create("Frame", {
        Name = "LogoBox",
        Parent = Header,
        Size = UDim2New(0, 48, 0, 48),
        BackgroundColor3 = self.Theme.Inline
    })
    self:AddToTheme(LogoBox, { BackgroundColor3 = "Inline" })
    GradientStroke(LogoBox, 1)

    Create("ImageLabel", {
        Name = "Icon",
        Parent = LogoBox,
        AnchorPoint = Vector2New(0.5, 0.5),
        Position = UDim2New(0.5, 0, 0.5, 0),
        Size = UDim2New(0, 28, 0, 28),
        Image = Opt(Data, "Logo", "rbxassetid://0"),
        ImageColor3 = FromRGB(24, 105, 164)
    })

    local CloseButton = Create("TextButton", {
        Name = "CloseButton",
        Parent = Header,
        AnchorPoint = Vector2New(1, 0),
        Position = UDim2New(1, 0, 0, 0),
        Size = UDim2New(0, 48, 0, 48),
        BackgroundColor3 = self.Theme.Inline
    })
    self:AddToTheme(CloseButton, { BackgroundColor3 = "Inline" })
    GradientStroke(CloseButton, 1)

    local CloseX = Create("TextLabel", {
        Parent = CloseButton,
        Size = UDim2New(1, 0, 1, 0),
        Text = "X",
        TextSize = 18,
        TextColor3 = self.Theme.Close,
        TextXAlignment = TCenter,
        TextYAlignment = Enum.TextYAlignment.Center
    })
    self:AddToTheme(CloseX, { TextColor3 = "Close" })

    CloseButton.MouseButton1Click:Connect(function()
        Library:Unload()
    end)

    local TabsBar = Create("Frame", {
        Name = "TabsBar",
        Parent = Header,
        Position = UDim2New(0, 56, 0, 9),
        Size = UDim2New(1, -116, 0, 30),
        BackgroundTransparency = 1
    })

    Create("UIListLayout", {
        Parent = TabsBar,
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDimNew(0, 6),
        VerticalAlignment = Enum.VerticalAlignment.Center
    })

    local Body = Create("Frame", {
        Name = "Body",
        Parent = MainFrame,
        Position = UDim2New(0, 12, 0, 68),
        Size = UDim2New(1, -24, 1, -80),
        BackgroundTransparency = 1
    })

    local FirstPage = true
    function WindowClass:Page(PageData)
        local PageName = Opt(PageData, "Name", "Page")
        local PageClass = {}

        local TabButton = Create("TextButton", {
            Parent = TabsBar,
            Size = UDim2New(0, 75, 1, 0),
            BackgroundColor3 = self.Theme.Inline,
            Text = PageName,
            TextColor3 = self.Theme.Text
        })
        self:AddToTheme(TabButton, { BackgroundColor3 = "Inline", TextColor3 = "Text" })
        GradientStroke(TabButton, 1)

        local PageContainer = Create("Frame", {
            Parent = Body,
            Size = UDim2New(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Visible = FirstPage
        })

        if FirstPage then
            TabButton.TextColor3 = self.Theme.TextActive
            FirstPage = false
        end

        TabButton.MouseButton1Click:Connect(function()
            for _, p in pairs(WindowClass.Pages) do
                p.Container.Visible = false
                p.Button.TextColor3 = Library.Theme.Text
            end
            PageContainer.Visible = true
            TabButton.TextColor3 = Library.Theme.TextActive
        end)

        PageClass.Container = PageContainer
        PageClass.Button = TabButton
        table.insert(WindowClass.Pages, PageClass)

        return PageClass
    end

    function WindowClass:SetOpen(Bool)
        MainFrame.Visible = Bool
    end

    function WindowClass:Toggle()
        MainFrame.Visible = not MainFrame.Visible
    end

    return WindowClass
end

