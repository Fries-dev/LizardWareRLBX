local function MakeGradient(Accent)
    local Dark = Accent:Lerp(Color3.new(0, 0, 0), 0.55)
    local Light = Accent:Lerp(Color3.new(1, 1, 1), 0.75)

    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, Dark),
        ColorSequenceKeypoint.new(0.15, Light),
        ColorSequenceKeypoint.new(0.45, Accent),
        ColorSequenceKeypoint.new(0.8, Dark),
        ColorSequenceKeypoint.new(1, Accent),
    })
end

